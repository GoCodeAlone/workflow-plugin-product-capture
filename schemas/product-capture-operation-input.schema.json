{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://providers/workflow-plugin-product-capture/browser/operations/capture_product/input/v1",
  "title": "Product capture operation input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://(?:[Ww][Ww][Ww]\\.)?[Aa][Mm][Aa][Zz][Oo][Nn]\\.[Cc][Oo][Mm](?::443)?/(?:[^?#]*/)?(?:dp/[A-Za-z0-9]{10}|gp/product/[A-Za-z0-9]{10}|gp/aw/d/[A-Za-z0-9]{10})(?:/[^?#]*)?(?:\\?[^#]*)?(?:#.*)?$",
      "description": "HTTPS Amazon product detail URL containing a 10-character ASIN."
    },
    "allowed_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[Ww][Ww][Ww]\\.)?[Aa][Mm][Aa][Zz][Oo][Nn]\\.[Cc][Oo][Mm]$"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "Exact host allow-list for the submitted URL."
    },
    "warmup_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[Ww][Ww][Ww]\\.)?[Aa][Mm][Aa][Zz][Oo][Nn]\\.[Cc][Oo][Mm](?::443)?/$",
      "description": "Optional same-origin Amazon homepage to load before naturally navigating to the product URL."
    },
    "capture_mode": {
      "type": "string",
      "enum": ["browser", "metadata"]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "max_html_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "max_image_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "metadata_only": {
      "type": "boolean"
    }
  },
  "required": ["url", "allowed_hosts"]
}
